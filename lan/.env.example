# Copy this file to .env and fill in all three secrets before starting Compose.
# Each secret must be longer than 1 character. No character restrictions.
# The admin token is required only when registering the first website account.
ARENA_ADMIN_TOKEN=
ARENA_DB_PASSWORD=
ARENA_DB_EDITOR_PASSWORD=

# Published host ports and interfaces.
SZERO_BIND_IP=0.0.0.0
SZERO_PORT=27150
ARENA_WEB_PORT=8080
ARENA_DB_BIND_IP=0.0.0.0
ARENA_DB_PORT=3306

# Optional public website URL when using a reverse proxy that rewrites Host.
# Example: https://arena.example.com/arena/
ARENA_PUBLIC_URL=
